{
  "name": "runtimehell",
  "private": true,
  "version": "0.1.0-alpha.8",
  "description": "RuntimeHell - multi-runtime JS/TS playground with engine internals analysis",
  "author": "RuntimeHell contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-lexus/RuntimeHell.git"
  },
  "homepage": "https://github.com/mr-lexus/RuntimeHell",
  "packageManager": "pnpm@12.8.1",
  "main": "out/main/index.js",
  "scripts": {
    "brand:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-main-assets.mjs",
    "preview": "electron-vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "lint": "node scripts/lint-gates.mjs",
    "deps:check": "pnpm peers check && pnpm audit --audit-level=low",
    "gen-fixtures": "node scripts/gen-fixtures.mjs",
    "typecheck:all": "node scripts/typecheck.mjs --all",
    "compatibility": "node scripts/e2e-compatibility.mjs",
    "release:validate": "node scripts/validate-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  }
}
